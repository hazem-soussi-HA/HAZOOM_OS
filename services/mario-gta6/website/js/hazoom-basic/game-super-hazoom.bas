4000 REM ========================================
4010 REM READ INPUT
4020 REM ========================================
4030 REM KEY(0)=UP KEY(1)=DOWN KEY(2)=LEFT KEY(3)=RIGHT KEY(4)=SPACE
4040 IF KEY(3) = 1 THEN VX = 3: DIR = 1: REM RIGHT
4050 IF KEY(2) = 1 THEN VX = -3: DIR = -1: REM LEFT
4060 IF KEY(4) = 1 AND JUMP = 0 THEN VY = -8: JUMP = 1: SOUND 400,5: REM JUMP
4070 IF KEY(2) = 0 AND KEY(3) = 0 THEN VX = 0
4080 RETURN

5000 REM ========================================
5010 REM UPDATE PLAYER (HAZOOM)
5020 REM ========================================
5030 REM Apply velocity
5040 PX = PX + VX
5050 PY = PY + VY
5060 REM
5070 REM Gravity
5080 IF PY < GROUND THEN VY = VY + 1
5090 IF PY >= GROUND THEN PY = GROUND: VY = 0: JUMP = 0
5100 REM
5110 REM Screen bounds
5120 IF PX < 0 THEN PX = 0
5130 IF PX > 152 THEN PX = 152
5140 REM
5150 REM Invincibility countdown
5160 IF INV > 0 THEN INV = INV - 1
5170 RETURN

6000 REM ========================================
6010 REM UPDATE ENEMIES (Shadow Agents)
6020 REM ========================================
6030 IF E1A = 1 THEN E1X = E1X + E1DX
6040 IF E1X < 10 OR E1X > 140 THEN E1DX = E1DX * -1
6050 IF E2A = 1 THEN E2X = E2X + E2DX
6060 IF E2X < 10 OR E2X > 140 THEN E2DX = E2DX * -1
6070 IF E3A = 1 THEN E3X = E3X + E3DX
6080 IF E3X < 10 OR E3X > 140 THEN E3DX = E3DX * -1
6090 IF E4A = 1 THEN E4X = E4X + E4DX
6100 IF E4X < 10 OR E4X > 140 THEN E4DX = E4DX * -1
6110 RETURN

6500 REM ========================================
6510 REM UPDATE COINS (animation)
6520 REM ========================================
6530 REM Coins bob up and down
6540 RETURN

7000 REM ========================================
7010 REM CHECK COLLISIONS
7020 REM ========================================
7030 REM Player vs Enemies
7040 IF INV > 0 THEN GOTO 7480
7050 GOSUB 7100: REM Enemy 1
