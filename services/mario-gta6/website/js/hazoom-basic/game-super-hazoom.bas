7070 GOSUB 7300: REM Enemy 3
7080 GOSUB 7400: REM Enemy 4
7090 GOTO 7480
7100 REM Check enemy 1
7110 IF E1A = 0 THEN RETURN
7120 DX = PX - E1X: DY = PY - E1Y
7130 IF DX < 0 THEN DX = -DX
7140 IF DY < 0 THEN DY = -DY
7150 IF DX < 8 AND DY < 8 THEN GOSUB 7600
7160 RETURN
