8000 REM ========================================
8010 REM RENDER SCREEN
8020 REM ========================================
8030 CLS
8040 REM
8050 REM --- Sky ---
8060 COLOR 8, 8
8070 RECT 0, 0, 160, 192
8080 REM
8090 REM --- Clouds ---
8100 COLOR 1, 0
8110 TILE 10, 2, 7
8120 TILE 14, 2, 7
8130 TILE 10, 17, 5
8140 REM
8150 REM --- Buildings (Liberty City skyline) ---
8160 COLOR 12, 0
8170 TILE 5, 6, 8: TILE 5, 7, 8: TILE 5, 8, 8: TILE 5, 9, 8
8180 TILE 7, 10, 8: TILE 7, 11, 8: TILE 7, 12, 8
8190 TILE 9, 14, 8: TILE 9, 15, 8: TILE 9, 16, 8: TILE 9, 17, 8
8200 REM
8210 REM --- Ground ---
8220 COLOR 10, 0
8230 FOR I = 0 TO 19
8240 TILE I, 20, 2
8250 TILE I, 21, 2
8260 NEXT I
8270 REM
8280 REM --- Road ---
8290 COLOR 12, 0
8300 FOR I = 0 TO 19
8310 TILE I, 22, 11
8320 NEXT I
8330 REM
8340 REM --- Coins ---
8350 COLOR 5, 0
8360 IF C1A = 1 THEN TILE 2, 17, 6
8370 IF C2A = 1 THEN TILE 4, 15, 6
8380 IF C3A = 1 THEN TILE 6, 17, 6
8390 IF C4A = 1 THEN TILE 8, 15, 6
8400 IF C5A = 1 THEN TILE 3, 12, 6
8410 IF C6A = 1 THEN TILE 5, 12, 6
8420 IF C7A = 1 THEN TILE 7, 12, 6
8430 IF C8A = 1 THEN TILE 9, 17, 6
8440 REM
8450 REM --- Star ---
8460 IF SA = 1 THEN COLOR 5, 0: TILE 11, 10, 15
8470 REM
8480 REM --- Enemies (Shadow Agents) ---
8490 COLOR 2, 0: REM Red
8500 IF E1A = 1 THEN SPRITE 1, E1X, E1Y
8510 IF E2A = 1 THEN SPRITE 2, E2X, E2Y
8520 COLOR 4, 0: REM Blue (police)
8530 IF E3A = 1 THEN SPRITE 3, E3X, E3Y
8540 IF E4A = 1 THEN SPRITE 4, E4X, E4Y
8550 REM
8560 REM --- Player (HAZOOM) ---
8570 IF INV > 0 AND TIMER MOD 4 < 2 THEN GOTO 8600
8580 COLOR 2, 0: REM Red
8590 SPRITE 0, PX, PY
8600 RETURN

9000 REM ========================================
9010 REM DRAW HUD
9020 REM ========================================
9030 COLOR 1, 0: REM White
9040 REM Score bar
9050 RECT 4, 4, 50, 8
9060 REM HAZOOM label area
9070 RECT 4, 14, 30, 8
9080 REM Lives display
9090 FOR I = 0 TO LIVES - 1
9100 RECT 120 + I * 10, 4, 6, 6
9110 NEXT I
9120 RETURN

9500 REM ========================================
9510 REM GAME OVER SCREEN
9520 REM ========================================
9530 CLS
9540 COLOR 2, 0: REM Red
9550 RECT 30, 60, 100, 40
9560 COLOR 1, 0: REM White
9570 RECT 40, 70, 80, 20
9580 SOUND 200, 20: SOUND 150, 20: SOUND 100, 20
9590 WAIT 120
9600 RETURN
