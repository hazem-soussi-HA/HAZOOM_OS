# Planet Earth News — git ignore
# Sovereignty: never commit secrets, venvs, or local caches.

.venv/
__pycache__/
*.pyc
.env
.env.*
*.log
*.out
.cache/
instance/

# Service runtime artifacts (managed by serve.sh)
.pen.pid
logs/
cache/

# Local TLS material (self-signed, generated locally; never commit)
certs/

# Frontend build output (generated by scripts/build_assets.sh)
node_modules/
static/app.min.js
static/style.min.css
