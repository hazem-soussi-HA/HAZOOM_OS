# Copy this file to .env and adjust as needed. The app runs with these defaults even if unset.

# Server
PORT=4000
NODE_ENV=development

# JWT signing secret. CHANGE THIS in any real deployment.
JWT_SECRET=change-me-in-production-please

# Client origin allowlist (comma-separated). Used for CORS in dev where SPA is served from same origin.
CLIENT_ORIGIN=http://localhost:4000

# SQLite database file location
DB_PATH=./data/birds.db

# Create an initial admin account on first seed (username/password/email).
# Leave blank to skip automatic admin creation.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@birds.local
