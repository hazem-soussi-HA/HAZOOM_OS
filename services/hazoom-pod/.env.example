# ============================================================
#  HAZOOM — Print-on-Demand E-commerce Platform
#  Copy this file to ".env" and fill in real values.
# ============================================================

# ---- Server ----
# Port the Express API listens on
PORT=4000
# Comma-separated list of allowed CORS origins (frontend URL)
CLIENT_ORIGIN=http://localhost:5500,http://localhost:4000
# Set to "production" to tighten security headers
NODE_ENV=development

# ---- Authentication ----
# Secret used to sign JWTs. GENERATE A STRONG RANDOM VALUE IN PRODUCTION!
# Example: run `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Database ----
# We use SQLite for zero-config local runs. The file is created automatically.
# To use MongoDB instead, set DB_TYPE=mongo and provide MONGO_URI, then swap
# the models to Mongoose (see README "Switching to MongoDB").
DB_TYPE=sqlite
SQLITE_PATH=./data/hazoom.db
# MONGO_URI=mongodb://localhost:27017/hazoom

# ---- Stripe (Payments, TEST MODE) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public key is safe to expose to the browser
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- Printify (POD fulfillment) ----
PRINTIFY_API_TOKEN=your_printify_api_token
PRINTIFY_SHOP_ID=your_printify_shop_id
# Leave blank to run in "mock mode" (no real API calls, simulated responses)
PRINTIFY_API_BASE=https://api.printify.com/v1

# ---- Email (order confirmations) ----
# Example uses Gmail SMTP; use your provider's settings.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Hazoom Store <no-reply@hazoom.example>

# ---- Admin bootstrap ----
# On first run, an admin account is created with these credentials if enabled.
SEED_ADMIN_EMAIL=admin@hazoom.example
SEED_ADMIN_PASSWORD=Admin123!
