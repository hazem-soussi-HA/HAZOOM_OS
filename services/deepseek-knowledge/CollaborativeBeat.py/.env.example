# CollaborativeBeat v4 — environment
# Copy this file to .env and fill in a strong SESSION_KEY.
# IMPORTANT: .env is git-ignored. Never commit it.

# Secret bearer token. Generate one with:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_KEY=change_me_to_a_long_random_hex_string

# Port the local server binds to (loopback only, 127.0.0.1).
CB_PORT=5000

# Set to 0 to DISABLE the spoken voice (gTTS) entirely -> zero network egress.
CB_VOICE=1

# --- Local LLM brain (ornith:35b via local Ollama, CPU/assembly mode) ---
# The neural core's *spoken line* is generated by the owner's local model when
# available; otherwise it falls back to the built-in heuristic. STRICTLY LOCAL:
# the only network egress is to 127.0.0.1:11434 (the Ollama daemon).
# Set CB_LLM=0 to force the heuristic core (zero LLM egress).
CB_LLM=1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=ornith:35b
# Leave OLLAMA_API_KEY empty unless you secured your local Ollama daemon.
OLLAMA_API_KEY=
