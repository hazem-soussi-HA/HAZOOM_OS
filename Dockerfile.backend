# HAZOOM OS v6.0 — Backend Dockerfile (optimized)
FROM node:20-alpine
WORKDIR /app
COPY package.json ./
COPY node_modules ./node_modules
COPY server.js ./
COPY core/ ./core/
COPY kernel/ ./kernel/
COPY memory/ ./memory/
COPY config/default.json ./config/
RUN mkdir -p /app/data/qlearner
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 CMD wget -qO- http://localhost:3000/health || exit 1
CMD ["node", "server.js"]
