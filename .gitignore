# Hazoom OS Unified .gitignore

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environment
.venv/
voice_env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# OS generated files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# SSL certificates (generate locally)
ssl/server.key
ssl/server.crt

# Logs
logs/
*.log
*.pid

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Storage and temp
storage/
temp/
tmp/

# Rust build artifacts (games)
**/wasm/target/
**/wasm/pkg/

# Node build outputs
dist/
build/
.next/
