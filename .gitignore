# HAZOOM OS Unified .gitignore

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environment
.venv*/
voice_env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environment files
.env
.env.local
.env.*.local
*.env

# OS generated files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# SSL certificates (generate locally)
ssl/server.key
ssl/server.crt
config/ssl/
config/security/
core/server.crt
core/server.key
**/certs/

# Rust build artifacts
**/wasm/target/
**/wasm/pkg/

# Build artifacts
*.o
*.elf
*.bin
*.so
*.iso
*.img
boot/*.o
kernel/c/*.o
kernel/*.o
**/*.gch

# Logs
logs/
*.log
*.pid

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Storage and temp
storage/
temp/
tmp/

# Security & secrets
config/credentials.json
config/hazoom-auth/
data/qlearner/state.json
memory/
**/*.key
**/wallet*.json
*.gpg

# Godot
.godot/
*.import
*.uid

# DB
*.db
*.db-shm
*.db-wal

# Generated
iso_root/
