# Hazoom OS Unified .gitignore

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environment
.venv/
voice_env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# OS generated files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# SSL certificates (generate locally)
ssl/server.key
ssl/server.crt
config/ssl/
config/security/
core/server.crt
core/server.key

# Rust build artifacts (games)
apps/games/super-mario-gta6/rust/mario_gta6_physics/target/
apps/games/neon-drift/wasm/target/

# Logs
logs/
*.log
*.pid

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Storage and temp
storage/
temp/
tmp/

# Rust build artifacts (games)
**/wasm/target/
**/wasm/pkg/

# Build artifacts
*.o
*.elf
*.bin
*.so
*.iso
*.img
boot/*.o
kernel/c/*.o
kernel/*.o

# Environment
.env
.hermes/

# Node build outputs
dist/
build/
.next/

# v5.0 Security
ssl/*.key
core/*.key
config/credentials.json
data/qlearner/state.json
*.log
__pycache__/
