# Secure Map Proxy Configuration

# Server Settings
PORT=8443
NODE_ENV=production

# SSL Configuration
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# Security Settings
SECURE_PROXY=true
CSP_ENABLED=true
X_FRAME_OPTIONS=DENY
HSTS_MAX_AGE=31536000

# Map Settings
MAP_CENTER_LAT=20
MAP_CENTER_LNG=0
MAP_ZOOM=2

# Logging
LOG_LEVEL=info
