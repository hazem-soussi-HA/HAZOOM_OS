# HAZOOM OS v6.0 - Environment Configuration
# Copy to .env and fill in your values

# Server
NODE_ENV=production
HOST=0.0.0.0
HTTP_PORT=3000
HTTPS_PORT=3443

# AI Integration
OLLAMA_HOST=http://localhost:11434

# Web3 / Blockchain
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
ETH_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com

# Payments
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
STRIPE_SECRET_KEY=

# Security
JWT_SECRET=change-this-to-a-random-secret
SESSION_SECRET=change-this-to-another-random-secret
ADMIN_TOKEN=change-this-to-admin-token

# Q-Learning
QLEARNING_ENABLED=true
QLEARNING_MODE=hybrid
QLEARNING_PERSIST_PATH=data/qlearner

# Monitoring
LOG_LEVEL=info
METRICS_ENABLED=true
